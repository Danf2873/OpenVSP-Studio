{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVSP Studio",
  "version": "0.1.0",
  "identifier": "gov.nasa.openvsp.studio",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenVSP Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "transparent": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "OpenVSP Studio",
    "shortDescription": "Friendly desktop GUI for OpenVSP 3.54",
    "longDescription": "OpenVSP Studio bundles the OpenVSP 3.54 engine (Python API, VSPAERO and friends) with a modern desktop interface.",
    "category": "Productivity",
    "resources": {
      "../bundle/openvsp/": "openvsp/",
      "../bundle/python/": "python/"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
